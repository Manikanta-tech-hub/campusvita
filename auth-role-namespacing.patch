diff -ruN a/app/lib/auth.ts b/app/lib/auth.ts
--- a/app/lib/auth.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/app/lib/auth.ts	2026-08-17 18:42:43.887251500 +0000
@@ -0,0 +1,114 @@
+// =====================================================================
+// Role-namespaced auth session storage
+// =====================================================================
+// Problem this fixes:
+//   Every page used to call sessionStorage.getItem("access_token") /
+//   setItem("access_token", ...) with the SAME key regardless of who
+//   was logging in. Logging in as a regular user in one tab (or after
+//   the admin panel was already open) silently overwrote the admin's
+//   token, refresh token, and profile fields — because there was only
+//   ever one slot for all of that data.
+//
+// Fix:
+//   Namespace every stored key by role ("admin" | "user") so an admin
+//   session and a regular user session can never collide, even in the
+//   same browser tab.
+// =====================================================================
+
+export type AuthRole = "admin" | "user";
+
+const SESSION_FIELDS = [
+  "access_token",
+  "refresh_token",
+  "token_type",
+  "expires_in",
+  "isLoggedIn",
+  "userEmail",
+  "email",
+  "userName",
+  "userRole",
+] as const;
+
+type SessionField = (typeof SESSION_FIELDS)[number];
+
+function keyFor(field: SessionField, role: AuthRole): string {
+  return `${role}_${field}`;
+}
+
+export type LoginResponseData = {
+  access_token: string;
+  refresh_token: string;
+  token_type: string;
+  expires_in: number;
+  user: {
+    email: string;
+    name: string;
+    role: string;
+  };
+};
+
+/**
+ * Normalizes whatever the backend sends back in `user.role` into one of
+ * our two storage namespaces. Anything that isn't literally "admin" is
+ * treated as a regular user.
+ */
+export function normalizeRole(role: string | undefined | null): AuthRole {
+  // Backend sends UserRole.ADMIN = "ADMIN" (see main.py). Anything else
+  // (including missing/unknown values) is treated as a regular user.
+  return role === "ADMIN" ? "admin" : "user";
+}
+
+/** Save a login response under its own role's namespace only. */
+export function saveAuthSession(data: LoginResponseData): AuthRole {
+  const role = normalizeRole(data.user.role);
+
+  sessionStorage.setItem(keyFor("isLoggedIn", role), "true");
+  sessionStorage.setItem(keyFor("access_token", role), data.access_token);
+  sessionStorage.setItem(keyFor("refresh_token", role), data.refresh_token);
+  sessionStorage.setItem(keyFor("token_type", role), data.token_type);
+  sessionStorage.setItem(keyFor("expires_in", role), String(data.expires_in));
+  sessionStorage.setItem(keyFor("userEmail", role), data.user.email);
+  sessionStorage.setItem(keyFor("email", role), data.user.email);
+  sessionStorage.setItem(keyFor("userName", role), data.user.name);
+  sessionStorage.setItem(keyFor("userRole", role), data.user.role);
+
+  return role;
+}
+
+export function getAccessToken(role: AuthRole): string | null {
+  return sessionStorage.getItem(keyFor("access_token", role));
+}
+
+export function getSessionField(
+  field: SessionField,
+  role: AuthRole
+): string | null {
+  return sessionStorage.getItem(keyFor(field, role));
+}
+
+export function setSessionField(
+  field: SessionField,
+  value: string,
+  role: AuthRole
+): void {
+  sessionStorage.setItem(keyFor(field, role), value);
+}
+
+export function isLoggedIn(role: AuthRole): boolean {
+  return sessionStorage.getItem(keyFor("isLoggedIn", role)) === "true";
+}
+
+export function clearAuthSession(role: AuthRole): void {
+  for (const field of SESSION_FIELDS) {
+    sessionStorage.removeItem(keyFor(field, role));
+  }
+}
+
+/** Throws if there's no token for this role — mirrors the old inline checks. */
+export function requireAuthHeader(role: AuthRole): { Authorization: string } {
+  const token = getAccessToken(role);
+  if (!token) {
+    throw new Error("No access token found");
+  }
+  return { Authorization: `Bearer ${token}` };
+}
