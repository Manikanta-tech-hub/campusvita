diff --git a/frontend/app/lib/auth.ts b/frontend/app/lib/auth.ts
new file mode 100644
--- /dev/null
+++ b/frontend/app/lib/auth.ts
@@ -0,0 +1,91 @@
+export type AuthRole = "admin" | "user";
+
+const SESSION_FIELDS = [
+  "access_token",
+  "refresh_token",
+  "token_type",
+  "expires_in",
+  "isLoggedIn",
+  "userEmail",
+  "email",
+  "userName",
+  "userRole",
+] as const;
+
+type SessionField = (typeof SESSION_FIELDS)[number];
+
+function keyFor(field: SessionField, role: AuthRole): string {
+  return `${role}_${field}`;
+}
+
+export type LoginResponseData = {
+  access_token: string;
+  refresh_token: string;
+  token_type: string;
+  expires_in: number;
+  user: {
+    email: string;
+    name: string;
+    role: string;
+  };
+};
+
+export function normalizeRole(role: string | undefined | null): AuthRole {
+  return role === "ADMIN" ? "admin" : "user";
+}
+
+export function saveAuthSession(data: LoginResponseData): AuthRole {
+  const role = normalizeRole(data.user.role);
+
+  localStorage.setItem(keyFor("isLoggedIn", role), "true");
+  localStorage.setItem(keyFor("access_token", role), data.access_token);
+  localStorage.setItem(keyFor("refresh_token", role), data.refresh_token);
+  localStorage.setItem(keyFor("token_type", role), data.token_type);
+  localStorage.setItem(keyFor("expires_in", role), String(data.expires_in));
+  localStorage.setItem(keyFor("userEmail", role), data.user.email);
+  localStorage.setItem(keyFor("email", role), data.user.email);
+  localStorage.setItem(keyFor("userName", role), data.user.name);
+  localStorage.setItem(keyFor("userRole", role), data.user.role);
+
+  return role;
+}
+
+export function getAccessToken(role: AuthRole): string | null {
+  return localStorage.getItem(keyFor("access_token", role));
+}
+
+export function getSessionField(field: SessionField, role: AuthRole): string | null {
+  return localStorage.getItem(keyFor(field, role));
+}
+
+export function setSessionField(field: SessionField, value: string, role: AuthRole): void {
+  localStorage.setItem(keyFor(field, role), value);
+}
+
+export function isLoggedIn(role: AuthRole): boolean {
+  return localStorage.getItem(keyFor("isLoggedIn", role)) === "true";
+}
+
+export function clearAuthSession(role: AuthRole): void {
+  for (const field of SESSION_FIELDS) {
+    localStorage.removeItem(keyFor(field, role));
+  }
+}
+
+export function requireAuthHeader(role: AuthRole): { Authorization: string } {
+  const token = getAccessToken(role);
+  if (!token) {
+    throw new Error("No access token found");
+  }
+  return { Authorization: `Bearer ${token}` };
+}
+
+// Remove the old shared session keys once, but never remove either
+// role-namespaced session. This prevents stale shared values from being
+// accidentally used by code that has not yet been migrated.
+export function clearLegacyAuthKeys(): void {
+  for (const field of SESSION_FIELDS) {
+    localStorage.removeItem(field);
+  }
+}
+
